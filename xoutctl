#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PLAYBOOK="${XOUT_PLAYBOOK:-$SCRIPT_DIR/xout_update_role.yml}"
ANSIBLE_PLAYBOOK="${ANSIBLE_PLAYBOOK:-ansible-playbook}"

declare -A INVENTORIES=(
  [HB_TEST]="HB_TEST_XOUT.ini"
  [HB_MIGRATION]="HB_MIG_XOUT.ini"
  [HB_PRODUKTION]="HB_PROD_XOUT.ini"
  [NDS_TEST]="NDS_TEST_XOUT.ini"
  [NDS_MIGRATION]="NDS_MIG_XOUT.ini"
  [NDS_PRODUKTION]="NDS_PROD_XOUT.ini"
)

usage() {
  cat <<'EOF'
Usage:
  ./xoutctl
  ./xoutctl ENV ACTION [RELEASE_FILE] [--component COMPONENT] [--allow-downgrade] [--verbose] [--yes]

Interactive mode:
  Run ./xoutctl without arguments. One or more environments can be selected,
  followed by one action. Selected environments are processed sequentially and
  the workflow stops immediately if one environment fails.

ENV:
  HB_TEST | HB_MIGRATION | HB_PRODUKTION
  NDS_TEST | NDS_MIGRATION | NDS_PRODUKTION
  Short aliases HB_MIG/HB_PROD/NDS_MIG/NDS_PROD are accepted.

ACTION:
  status | plan | install | update | start | stop | restart

Output:
  Compact operator output is the default. It shows the effective package plan,
  lifecycle phases, status, warnings/failures and the final result while hiding
  routine Ansible task/loop/skip/timing noise.

  --verbose restores the native full Ansible output for troubleshooting,
  including callbacks configured by the controller's Ansible configuration.

  Examples:
    ./xoutctl NDS_PROD status
    ./xoutctl NDS_PROD restart
    ./xoutctl NDS_PROD restart --verbose

Version selection:
  Without RELEASE_FILE, install/update/plan target the newest repository version
  of every component assigned to each host.

  With RELEASE_FILE, only packages listed in [packages] are changed. Components
  omitted from the file keep their installed version. Short versions such as
  25.10.1 resolve to the newest matching RPM release, for example 25.10.1-3.

Component-scoped update:
  --component COMPONENT limits plan/update to one operationally independent
  component. Only that component is stopped, changed and started; Pegasus,
  Portal module lifecycle, CUPS and unrelated XOUT services are not touched.

  Isolated component mode is guarded by the role variable
  xout_isolated_update_components. The default allowlist currently contains:
    web

  Examples:
    ./xoutctl NDS_PROD plan Release_WEB_26.7.ini --component web --allow-downgrade
    ./xoutctl NDS_PROD update Release_WEB_26.7.ini --component web --allow-downgrade
    ./xoutctl NDS_PROD update --component web

Release file example: examples/Release_25.10.ini

  [release]
  name=Release_25.10

  [packages]
  modeshape=25.10
  portal=25.10.1
  pmc=25.10
  web=25.10.1
  activemq=2.40.0.0
  # batchsplitter omitted -> keep installed version

Typical workflow:
  # Interactive multi-environment operation
  ./xoutctl

  # Inspect current state
  ./xoutctl NDS_TEST status

  # Preview update to newest versions from repository
  ./xoutctl NDS_TEST plan

  # Update existing environment to newest repository versions.
  # xoutctl automatically runs the preflight plan again and asks for confirmation.
  ./xoutctl NDS_PROD update

  # Preview/update only one isolated component without bouncing full XOUT.
  ./xoutctl NDS_PROD plan Release_WEB_26.7.ini --component web --allow-downgrade
  ./xoutctl NDS_PROD update Release_WEB_26.7.ini --component web --allow-downgrade

  # Maintenance window: stop XOUT first, let other teams perform their work,
  # then continue later with the XOUT update. A clean standalone stop does not
  # retain Portal module restore state. update detects that XOUT is already DOWN
  # and starts the environment again after package/UDU processing.
  ./xoutctl NDS_PROD stop
  # ... other maintenance work ...
  ./xoutctl NDS_PROD update

  # Preview/update only the versions defined by a release file
  ./xoutctl NDS_PROD plan examples/Release_25.10.ini
  ./xoutctl NDS_PROD update examples/Release_25.10.ini

  # Initial installation of an environment that is already DOWN
  ./xoutctl NDS_TEST install examples/Release_25.10.ini

  # Lifecycle only; no package update
  ./xoutctl NDS_TEST stop
  ./xoutctl NDS_TEST start
  ./xoutctl NDS_TEST restart

  # update/start/restart perform a final postcheck of XOUT services, boot policy,
  # CUPS, Portal/Jolokia/module-state cleanup and Pegasus.

  # Skip the wrapper confirmation (internal UDU prompt is not bypassed)
  ./xoutctl NDS_TEST restart --yes

  # Downgrades are rejected unless explicitly allowed
  ./xoutctl NDS_TEST update examples/Release_25.10.ini --allow-downgrade

Examples:
  ./xoutctl
  ./xoutctl NDS_TEST status
  ./xoutctl NDS_TEST plan
  ./xoutctl NDS_PROD stop
  ./xoutctl NDS_PROD update
  ./xoutctl NDS_PROD update examples/Release_25.10.ini
  ./xoutctl NDS_PROD update Release_WEB_26.7.ini --component web --allow-downgrade
  ./xoutctl NDS_TEST stop
  ./xoutctl NDS_TEST start
  ./xoutctl NDS_TEST restart
EOF
}

canonical_env() {
  case "${1^^}" in
    HB_TEST) echo HB_TEST ;;
    HB_MIG|HB_MIGRATION) echo HB_MIGRATION ;;
    HB_PROD|HB_PRODUKTION|HB_PRODUCTION) echo HB_PRODUKTION ;;
    NDS_TEST) echo NDS_TEST ;;
    NDS_MIG|NDS_MIGRATION) echo NDS_MIGRATION ;;
    NDS_PROD|NDS_PRODUKTION|NDS_PRODUCTION) echo NDS_PRODUKTION ;;
    *) return 1 ;;
  esac
}

choose_environments() {
  local options=(HB_TEST HB_MIGRATION HB_PRODUKTION NDS_TEST NDS_MIGRATION NDS_PRODUKTION)
  local raw token candidate
  local -a selected=()
  local -A seen=()
  local valid
  local i

  while true; do
    echo "Environments:" >&2
    for i in "${!options[@]}"; do
      printf '  %d) %s\n' "$((i + 1))" "${options[$i]}" >&2
    done
    echo "  a) ALL" >&2
    echo "  q) Cancel" >&2
    printf 'Select one or more (for example 1,4,5): ' >&2
    read -r raw

    case "${raw,,}" in
      q|quit|cancel)
        return 0
        ;;
      a|all)
        printf '%s\n' "${options[@]}"
        return 0
        ;;
    esac

    raw="${raw//,/ }"
    selected=()
    seen=()
    valid=true
    for token in $raw; do
      if [[ ! "$token" =~ ^[1-6]$ ]]; then
        valid=false
        break
      fi
      candidate="${options[$((token - 1))]}"
      if [[ -z "${seen[$candidate]+x}" ]]; then
        selected+=("$candidate")
        seen["$candidate"]=1
      fi
    done

    if [[ "$valid" == true && ${#selected[@]} -gt 0 ]]; then
      printf '%s\n' "${selected[@]}"
      return 0
    fi

    echo "Invalid selection. Use numbers 1-6 separated by comma/space, 'a', or 'q'." >&2
    echo >&2
  done
}

choose_action() {
  local options=(status plan update install start stop restart)
  echo "Action:" >&2
  select choice in "${options[@]}" "Cancel"; do
    if [[ "$choice" == "Cancel" ]]; then
      exit 0
    elif [[ -n "$choice" ]]; then
      printf '%s\n' "$choice"
      return
    fi
  done
}

set_environment() {
  ENVIRONMENT=$1
  INVENTORY="$SCRIPT_DIR/${INVENTORIES[$ENVIRONMENT]}"
  [[ -f "$INVENTORY" ]] || {
    echo "Inventory not found: $INVENTORY" >&2
    exit 2
  }
}

run_playbook() {
  local action=$1
  local -a extra_vars=("xout_action=$action" "xout_environment=$ENVIRONMENT")
  if [[ -n "$RELEASE_FILE" ]]; then
    extra_vars+=("xout_release_file=$RELEASE_FILE")
  fi
  if [[ -n "$COMPONENT" ]]; then
    extra_vars+=("xout_component=$COMPONENT")
  fi
  if [[ "$ALLOW_DOWNGRADE" == true ]]; then
    extra_vars+=("xout_allow_downgrade=true")
  fi

  local -a cmd=("$ANSIBLE_PLAYBOOK" -i "$INVENTORY" "$PLAYBOOK")
  local item
  for item in "${extra_vars[@]}"; do
    cmd+=(-e "$item")
  done

  if [[ "$VERBOSE" == true ]]; then
    printf '\nCommand:\n  '
    printf '%q ' "${cmd[@]}"
    printf '\n\n'
    "${cmd[@]}"
    return
  fi

  local callback_path="$SCRIPT_DIR/callback_plugins"
  if [[ -n "${ANSIBLE_CALLBACK_PLUGINS:-}" ]]; then
    callback_path="$callback_path:$ANSIBLE_CALLBACK_PLUGINS"
  fi

  # Compact mode owns the console completely. In particular this overrides
  # controller-wide aggregate callbacks such as profile_tasks that would add
  # one timing line per task and defeat the compact operator view.
  ANSIBLE_STDOUT_CALLBACK=xout_compact \
  ANSIBLE_CALLBACK_PLUGINS="$callback_path" \
  ANSIBLE_CALLBACKS_ENABLED= \
  ANSIBLE_CALLBACK_WHITELIST= \
    "${cmd[@]}"
}

run_for_environments() {
  local action=$1
  local env
  for env in "${ENVIRONMENTS[@]}"; do
    set_environment "$env"
    echo
    echo "================================================================"
    echo "XOUT $action - $ENVIRONMENT"
    echo "Inventory: $(basename "$INVENTORY")"
    echo "================================================================"
    run_playbook "$action"
  done
}

confirm() {
  local prompt=$1
  if [[ "$ASSUME_YES" == true ]]; then
    return 0
  fi
  local answer
  read -r -p "$prompt [y/N] " answer
  [[ "$answer" =~ ^[Yy]([Ee][Ss])?$ ]]
}

print_summary() {
  local env
  echo
  echo "XOUT Manager"
  echo "  Action       : $ACTION"
  echo "  Environments:"
  for env in "${ENVIRONMENTS[@]}"; do
    printf '    - %s (%s)\n' "$env" "${INVENTORIES[$env]}"
  done
  echo "  Target       : ${RELEASE_FILE:-latest versions from repository}"
  echo "  Component    : ${COMPONENT:-full environment}"
  echo "  Downgrade    : $ALLOW_DOWNGRADE"
  echo "  Output       : $([[ "$VERBOSE" == true ]] && echo verbose || echo compact)"
}

ENVIRONMENT=""
INVENTORY=""
ACTION=""
RELEASE_FILE=""
COMPONENT=""
ALLOW_DOWNGRADE=false
ASSUME_YES=false
VERBOSE=false
declare -a ENVIRONMENTS=()

if [[ $# -eq 0 ]]; then
  mapfile -t ENVIRONMENTS < <(choose_environments)
  [[ ${#ENVIRONMENTS[@]} -gt 0 ]] || exit 0
  ACTION="$(choose_action)"
  if [[ "$ACTION" == "plan" || "$ACTION" == "install" || "$ACTION" == "update" ]]; then
    read -r -p "Release file (empty = latest): " RELEASE_FILE
  fi
else
  case "${1:-}" in
    -h|--help)
      usage
      exit 0
      ;;
  esac

  if [[ $# -lt 2 ]]; then
    usage >&2
    exit 2
  fi

  environment="$(canonical_env "$1")" || {
    echo "Unknown environment: $1" >&2
    exit 2
  }
  ENVIRONMENTS=("$environment")
  ACTION="${2,,}"
  shift 2

  if [[ $# -gt 0 && "${1:-}" != --* ]]; then
    RELEASE_FILE=$1
    shift
  fi

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --component)
        [[ $# -ge 2 ]] || { echo "--component requires a value" >&2; exit 2; }
        COMPONENT="${2,,}"
        shift
        ;;
      --component=*) COMPONENT="${1#*=}"; COMPONENT="${COMPONENT,,}" ;;
      --allow-downgrade) ALLOW_DOWNGRADE=true ;;
      --verbose) VERBOSE=true ;;
      -y|--yes) ASSUME_YES=true ;;
      -h|--help) usage; exit 0 ;;
      *) echo "Unknown option: $1" >&2; exit 2 ;;
    esac
    shift
  done
fi

case "$ACTION" in
  status|plan|install|update|start|stop|restart) ;;
  *) echo "Unknown action: $ACTION" >&2; exit 2 ;;
esac

if [[ -n "$COMPONENT" && "$ACTION" != "plan" && "$ACTION" != "update" ]]; then
  echo "--component is supported only with plan or update." >&2
  exit 2
fi

[[ -f "$PLAYBOOK" ]] || {
  echo "Playbook not found: $PLAYBOOK" >&2
  exit 2
}

for environment in "${ENVIRONMENTS[@]}"; do
  [[ -n "${INVENTORIES[$environment]+x}" ]] || {
    echo "Unknown environment: $environment" >&2
    exit 2
  }
  inventory="$SCRIPT_DIR/${INVENTORIES[$environment]}"
  [[ -f "$inventory" ]] || {
    echo "Inventory not found: $inventory" >&2
    exit 2
  }
done

if [[ -n "$RELEASE_FILE" ]]; then
  if [[ "$RELEASE_FILE" != /* ]]; then
    RELEASE_FILE="$(cd -- "$(dirname -- "$RELEASE_FILE")" && pwd)/$(basename -- "$RELEASE_FILE")"
  fi
  [[ -f "$RELEASE_FILE" ]] || {
    echo "Release file not found: $RELEASE_FILE" >&2
    exit 2
  }
fi

print_summary

if [[ "$ACTION" == "update" || "$ACTION" == "install" ]]; then
  echo
  echo "Preflight plan for all selected environments:"
  run_for_environments plan
  confirm "Proceed with $ACTION on ${#ENVIRONMENTS[@]} environment(s)?" || {
    echo "Cancelled."
    exit 0
  }
elif [[ "$ACTION" == "start" || "$ACTION" == "stop" || "$ACTION" == "restart" ]]; then
  confirm "Proceed with $ACTION on ${#ENVIRONMENTS[@]} environment(s)?" || {
    echo "Cancelled."
    exit 0
  }
fi

run_for_environments "$ACTION"
