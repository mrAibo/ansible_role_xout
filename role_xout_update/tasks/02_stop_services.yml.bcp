- name: Stop and Disable xout-web
  systemd:
    name: xout-web.service
    state: stopped
    enabled: false
  become: yes
  any_errors_fatal: true
  when: "'web' in group_names"
  tags: xout_stop_web




- name: Stop XOUT Portal Systemd Service
  shell: sudo systemctl stop xout-portal
  args:
    executable: /bin/bash
    # warn: false
  become: yes
  become_user: xout-adm
  when: "'portal' in group_names"
  tags: xout_stop

- name: Stop XOUT PMC Systemd Service
  shell: sudo systemctl stop xout-pmc
  args:
    executable: /bin/bash
    # warn: false
  become: yes
  become_user: xout-adm
  when: "'pmc' in group_names"
  tags: xout_stop

- name: Stop XOUT AMQ Systemd Service
  shell: sudo systemctl stop xout-activemq-artemis
  args:
    executable: /bin/bash
    # warn: false
  become: yes
  become_user: xout-adm
  when: "'activemq' in group_names"
  tags: xout_stop

- name: Stop XOUT ModeShape Systemd Service
  shell: sudo systemctl stop xout-modeshape
  args:
    executable: /bin/bash
    # warn: false
  become: yes
  become_user: xout-adm  
  when: "'modeshape' in group_names"
  tags: xout_stop


